{
	"schemaVersion": 1,
	"id": "cavefill",
	"version": "${version}",
	"name": "Cave Fill",
	"description": "Client-side occlusion that fills isolated caves with red concrete before other mods read the chunk, and restores them when a later world change opens them.",
	"authors": [
		"JustAlittleWolf"
	],
	"contact": {
		"issues": "https://github.com/JustAlittleWolf/EffectiveCaveCulling/issues/",
		"sources": "https://github.com/JustAlittleWolf/EffectiveCaveCulling/"
	},
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": [
			"me.wolfii.CavefillClient"
		]
	},
	"mixins": [
		"cavefill.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": ">=${minecraft_version}",
		"fabric-api": "*"
	},
	"suggests": {}
}
